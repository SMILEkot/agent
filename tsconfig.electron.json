{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/electron/**/*", "src/types/electron.d.ts", "src/types/ai.ts"],
  "exclude": ["node_modules", "dist", "src/components", "src/pages", "src/hooks", "src/store", "src/services"]
}

